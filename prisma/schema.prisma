// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  ARTISAN
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CLIENT)
  accounts      Account[]
  sessions      Session[]

  // Artisan specific
  artisanProfile ArtisanProfile?

  // Client specific
  orders         Order[]
  favorites      Favorite[]
  reviews        Review[]
  refundRequests RefundRequest[]

  // Messaging
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // Following System
  following ArtisanProfile[] @relation("UserFollowsArtisan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Message {
  id         String  @id @default(cuid())
  content    String  @db.Text
  senderId   String
  receiverId String
  productId  String?

  sender   User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  read       Boolean  @default(false)
  attachment String?  @db.Text

  @@index([receiverId, read])
  @@index([senderId, receiverId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum ArtisanStatus {
  PENDING
  APPROVED
  REJECTED
}

model ArtisanProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  bio             String?       @db.Text
  location        String?
  yearsOfExperience Int?        @default(1)
  avatar          String?       @db.Text
  studioName      String?
  slug            String?       @unique
  status          ArtisanStatus @default(PENDING)
  isVerified      Boolean       @default(false) // Keeping this as a "verified badge" flag if needed, but status will control visibility.
  instagram       String?
  website         String?
  pinterest       String?
  tiktok          String?
  facebook        String?
  brandColor      String?       @default("#da7b5a")
  bannerImage     String?       @db.Text
  phoneNumber     String?
  rejectionReason String?       @db.Text

  // Courier Pickup Exact Address (Admin & Logistics Only)
  pickupAddress   String?       @db.Text // Street name and number
  pickupCity      String?       // Governorate / City
  pickupDistrict  String?       // District / Neighborhood
  pickupBuilding  String?       // Building / Floor / Apartment
  pickupNotes     String?       @db.Text // Landmarks & driver instructions

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  coupons  Coupon[]

  // Financial fields
  commissionRate  Float         @default(0.0) // Platform commission (e.g., 15% is 0.15)
  payoutMethod    PayoutMethod? @default(INSTAPAY)
  payoutAddress   String?       // E.g., mobile number for Vodafone Cash or InstaPay handle
  payoutName      String?       // Beneficiary full name

  // Terms & Conditions Legal Audit Trail
  termsAcceptedAt DateTime?
  termsVersion    String?       // E.g., "2026-v2"
  agreementAcceptances ArtisanAgreementAcceptance[]

  // Financial ledger relationships
  balances        ArtisanBalance[]
  transactions    ArtisanTransaction[]

  // Following System
  followers User[] @relation("UserFollowsArtisan")

  // Bio Link system
  bioLinks ArtisanBioLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, createdAt(sort: Desc)])
}

model ArtisanAgreementAcceptance {
  id               String         @id @default(cuid())
  artisanId        String
  artisan          ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  agreementVersion String
  language         String
  acceptedAt       DateTime       @default(now())
  acceptanceMethod String         @default("CLICKWRAP")
  signerUserId     String
  signerName       String?
  userAgent        String?        @db.Text
  ipAddress        String?

  @@unique([artisanId, agreementVersion])
  @@index([artisanId, acceptedAt])
}

model ArtisanBioLink {
  id          String         @id @default(cuid())
  artisanId   String
  artisan     ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  title       String
  url         String
  icon        String?        // emoji or icon key
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  clicks      Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([artisanId])
}


enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
}

model Product {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String?       @unique
  description           String        @db.Text
  price                 Float
  images                String[]
  category              String
  subcategory           String?
  tags                  String[]
  canPersonalize        Boolean       @default(false)
  personalizationPrompt String? // Instruction for the buyer (e.g. "Enter name for engraving")
  requiresClientImage   Boolean       @default(false)
  clientImagePrompt     String?       // Instruction for client image upload (e.g. "Upload photo to print")
  badge                 String?
  stock                 Int           @default(1)
  status                ProductStatus @default(PENDING)
  rejectionReason       String?       @db.Text

  artisanId String
  artisan   ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  reviews     Review[]
  orderItems  OrderItem[]
  favoritedBy Favorite[]
  messages    Message[]
  views       Int         @default(0)

  variants ProductVariant[]

  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([artisanId])
  @@index([status, category])
  @@index([artisanId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([isFeatured, createdAt(sort: Desc)])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name  String // e.g., "Red / Large"
  price Float
  stock Int     @default(0)
  sku   String? @unique
  image String? @db.Text
  badge String?

  // Stores option values, e.g., { "Color": "Red", "Size": "Large" }
  options Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@index([productId])
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String   @db.Text
  images    String[] // URLs to Cloudinary images
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  artisanReply String? @db.Text
  artisanReplyDate DateTime?

  @@index([productId])
  @@index([userId])
  @@index([productId, rating])
  @@index([productId, createdAt(sort: Desc)])
}

model Order {
  id          String @id @default(cuid())
  userId      String?
  totalAmount Float
  status      String @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED

  shippingAddress String?
  shippingCity    String?
  shippingZip     String?
  shippingCountry String?
  clientPhone     String?
  clientEmail     String?
  orderNotes      String? @db.Text

  // Gift details
  isGift      Boolean @default(false)
  giftMessage String? @db.Text

  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  refundRequests RefundRequest[]

  // Coupon / Discount Integration
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  discountApplied Float?      @default(0)

  // Shipping Details
  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shippingCost     Float           @default(0)
  trackingNumber   String?
  carrier          String?

  // Financial ledger relation
  transactions    ArtisanTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([clientEmail])
  @@index([clientPhone])
  @@index([status, createdAt(sort: Desc)])
}

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String   // e.g., "Cairo & Giza", "Alexandria", "Rest of Egypt"
  price         Float    @default(0)
  estimatedDays String?  // e.g., "2-3 business days"
  isActive      Boolean  @default(true)
  
  orders        Order[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  price           Float
  personalization String?
  customImage     String? @db.Text
  variantId       String?
  status          String  @default("PENDING")
  trackingNumber  String?
  carrier         String?
  artisanNotes    String? @db.Text

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  refundRequests RefundRequest[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // e.g., "GIFT10", "WELCOME50"
  discountType   String    // "PERCENTAGE" (like 10% off) or "FIXED" (like 50 EGP off)
  discountValue  Float     // E.g., 10 for PERCENTAGE, 50 for FIXED
  minOrderAmount Float?    @default(0) // Coupon only valid if subtotal is >= minOrderAmount
  maxDiscount    Float?    // E.g., maximum cap for percentage discounts
  artisanId      String?   // If set, coupon only applies to this artisan's products
  artisan        ArtisanProfile? @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  expiresAt      DateTime? // Expiration boundary
  maxUses        Int?      // Maximum times coupon can be used globally
  usedCount      Int       @default(0) // Number of successful redemptions
  isActive       Boolean   @default(true)

  orders         Order[]   // Orders using this coupon

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code, isActive])
}

enum PayoutMethod {
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
}

model ArtisanBalance {
  id             String         @id @default(cuid())
  artisanId      String         @unique
  artisan        ArtisanProfile @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  
  pending        Float          @default(0.0) // Money earned but still in escrow / holding period
  withdrawable   Float          @default(0.0) // Money cleared and ready for payout
  withdrawn      Float          @default(0.0) // Total money successfully paid out to date
  
  updatedAt      DateTime       @updatedAt
}

model ArtisanTransaction {
  id          String            @id @default(cuid())
  artisanId   String
  artisan     ArtisanProfile    @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  amount      Float             // positive (earnings) or negative (payouts / refunds)
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  
  description String?
  createdAt   DateTime          @default(now())

  @@index([artisanId])
  @@index([orderId])
  @@index([type, status]) // Used by escrow clearance cron and admin payout queries
  @@index([artisanId, createdAt(sort: Desc)])
  @@index([artisanId, type, status])
}

enum TransactionType {
  SALE          // Earnings from a client order
  PAYOUT        // Money transferred from platform to artisan
  REFUND_DEBIT  // Money deducted from artisan due to customer refund
}

enum TransactionStatus {
  PENDING       // In holding period
  CLEARED       // Holding period ended, money moved to withdrawable
  COMPLETED     // For payout requests: payment sent to artisan bank/wallet
  FAILED        // Transaction cancelled or failed
}

enum RefundReason {
  DAMAGED_IN_TRANSIT
  DEFECTIVE_OR_WRONG_ITEM
  NOT_AS_DESCRIBED
  ORDER_NOT_RECEIVED
  OTHER
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  REPLACEMENT_ISSUED
}

model RefundRequest {
  id              String         @id @default(cuid())
  orderId         String
  orderItemId     String?
  userId          String
  
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  reason          RefundReason
  details         String         @db.Text
  images          String[]       // Photo evidence URLs
  preferredAction String         // "REFUND" or "REPLACEMENT"
  status          RefundStatus   @default(PENDING)
  adminNote       String?        @db.Text
  refundAmount    Float?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

enum ExpenseCategory {
  MARKETING
  PACKAGING_SUPPLIES
  LOGISTICS_SHIPPING
  SOFTWARE_SERVICES
  EQUIPMENT_TOOLS
  OFFICE_OPERATIONS
  SALARIES_CONTRACTORS
  OTHER
}

model PlatformExpense {
  id              String          @id @default(cuid())
  title           String
  category        ExpenseCategory @default(OTHER)
  amount          Float
  currency        String          @default("EGP")
  date            DateTime        @default(now())

  // Co-founder & Investor Workflow
  requestedBy     String          @default("HAZEM") // "HAZEM", "NOUR", "MOHAMED"
  fundingStatus   String          @default("PENDING_TRANSFER") // "PENDING_TRANSFER", "FUNDED", "REJECTED"
  fundedBy        String?         @default("Mohamed")
  fundedAt        DateTime?
  transferMethod  String?         // "INSTAPAY", "BANK_TRANSFER", "VODAFONE_CASH", "CASH"
  transferProofUrl String?        @db.Text

  paidBy          String?         // Person or payment source / recipient details
  paymentMethod   String?         // e.g. "CASH", "BANK_TRANSFER", "CARD", "WALLET", "INSTAPAY"
  receiptUrl      String?         @db.Text
  notes           String?         @db.Text
  createdById     String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([createdById])
  @@index([fundingStatus])
  @@index([requestedBy])
}

model AbandonedCheckout {
  id              String   @id @default(cuid())
  orderId         String?  @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String?  @db.Text
  shippingCity    String?
  totalAmount     Float
  items           Json
  orderNotes      String?  @db.Text
  couponCode      String?
  discountApplied Float?   @default(0)
  shippingCost    Float?   @default(0)
  status          String   @default("ABANDONED") // "ABANDONED", "FAILED_PAYMENT", "CONVERTED"
  isContacted     Boolean  @default(false)
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerEmail])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([status])
}

